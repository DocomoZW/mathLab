    {
      "id": "AL2_Q3_C01",
      "difficulty": "C",
      "skill_tags": ["simplification", "identities"],
      "problem_text": "Simplify $\\frac{\\sin^2\\theta}{1 - \\cos\\theta}$.",
      "answer": "$1 + \\cos\\theta$",
      "solution": "$\\frac{\\sin^2\\theta}{1 - \\cos\\theta} = \\frac{1 - \\cos^2\\theta}{1 - \\cos\\theta} = \\frac{(1-\\cos\\theta)(1+\\cos\\theta)}{1-\\cos\\theta} = 1 + \\cos\\theta$",
