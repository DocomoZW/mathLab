    {
      "id": "AM3_Q1_X2",
      "difficulty": "X",
      "skill_tags": [
        "variable_base"
      ],
      "problem_text": "If 2^x = 3^y = 6^{-z}, prove that 1/x + 1/y + 1/z = 0.",
      "answer": "Proof",
      "solution": "Let 2^x=3^y=6^{-z}=k. Then 2=k^{1/x}, 3=k^{1/y}, 6=k^{-1/z}. So 6=2x3 => k^{-1/z}=k^{1/x}k^{1/y}=k^{1/x+1/y}. So -1/z=1/x+1/y => 1/x+1/y+1/z=0",
      "marks": 4
    },
