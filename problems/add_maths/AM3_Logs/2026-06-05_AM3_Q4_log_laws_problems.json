    {
      "id": "AM3_Q4_X1",
      "difficulty": "X",
      "skill_tags": [
        "proof_law"
      ],
      "problem_text": "Prove that log_a(M/N) = log_a M - log_a N using index laws.",
      "answer": "Proof",
      "solution": "Let log_a M=x => a^x=M. Let log_a N=y => a^y=N. Then M/N = a^x/a^y = a^{x-y}. So log_a(M/N)=x-y=log_a M - log_a N",
      "marks": 3
